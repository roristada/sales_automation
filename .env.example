# Copy to .env.local and fill in. Never commit real values.

# Supabase (local: values printed by `npx supabase start`; cloud: Project Settings -> API).
# The anon key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/test only. Used by tests/rls to create test users against LOCAL Supabase. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Render worker (Milestone 4–5) — all optional ---
# ffprobe for render QA and asset dimensions, if it isn't on PATH.
# FFPROBE_PATH=
# Where render outputs and uploaded assets are stored (default: storage/renders).
# RENDER_STORAGE_DIR=
# Scratch space for Remotion while rendering (default: storage/tmp, i.e. not the system drive).
# RENDER_TMP_DIR=
# Remotion license: "free-license" (default) for individuals / companies with up to 3 employees.
# REMOTION_LICENSE_KEY=
# Estimated cost per second of rendered video, in THB, for usage and spending caps (default 0).
# RENDER_COST_THB_PER_VIDEO_SECOND=

# --- Production (Milestone 8, docs/DEPLOY.md) — optional ---
# After creating your own account: hide and refuse sign-up in the app (also disable sign-ups in Supabase Auth).
# DISABLE_SIGNUP=true
# Where `npm run backup` writes (default: backups/). Prefer another drive.
# BACKUP_DIR=

# --- AI via OpenRouter (docs/AI_VIDEO_PLAN.md) — optional ---
# One key for text, video and speech models. Server/worker only — never prefix with NEXT_PUBLIC_.
# Set a monthly limit on the key at openrouter.ai/settings/keys as a second safety net.
# OPENROUTER_API_KEY=
# THB per USD for logging AI cost and enforcing caps (OpenRouter bills in USD; default 35).
# USD_THB_RATE=35

# --- Not connected yet ---
# Thai voice-over (TTS) — provider not chosen yet (Google Cloud TTS or Azure Speech).
# GOOGLE_APPLICATION_CREDENTIALS=
# Shopee Affiliate Open API — only after access is confirmed for the account.
# SHOPEE_AFFILIATE_APP_ID=
# SHOPEE_AFFILIATE_SECRET=
